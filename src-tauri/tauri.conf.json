{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptDock",
  "version": "1.1.1",
  "identifier": "com.promptdock.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PromptDock",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      },
      {
        "label": "quick",
        "title": "PromptDock 快速搜索",
        "url": "index.html?window=quick",
        "width": 680,
        "height": 520,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "sticky",
        "title": "PromptDock 便签",
        "url": "index.html?window=sticky",
        "width": 420,
        "height": 695,
        "minWidth": 340,
        "minHeight": 270,
        "maxWidth": 420,
        "maxHeight": 695,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://localhost:*; connect-src ipc: http://ipc.localhost ws://localhost:* http://localhost:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
