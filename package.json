{
  "name": "promptdock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src vite.config.ts package.json",
    "format:check": "prettier --check src vite.config.ts package.json",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.5"
  }
}
